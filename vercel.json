{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/package.json",
      "use": "@vercel/node"
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -r --filter \"./lib/**\" --if-present run build && pnpm -r --filter \"./artifacts/api-server\" run build",
  "outputDirectory": "artifacts/api-server/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "artifacts/api-server/dist/index.mjs"
    }
  ]
}
