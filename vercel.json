{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": { "includeFiles": ["artifacts/api-server/dist/**", "artifacts/api-server/migrations/**"] }
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/api-server/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "artifacts/api-server/dist/index.mjs"
    }
  ]
}
