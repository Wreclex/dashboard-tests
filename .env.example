# ─── Database ────────────────────────────────────────────────────────────────
# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard

# ─── Encryption ────────────────────────────────────────────────────────────────
# 32-байтный hex-ключ (64 символа) для AES-256-GCM шифрования токенов
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_TOKEN_ENCRYPTION_KEY=

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Получить на https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_DOMAIN=
CLERK_JWT_KEY=
CLERK_MACHINE_SECRET_KEY=

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
BASE_PATH=
LOG_LEVEL=info

# ─── PostgreSQL SSL ────────────────────────────────────────────────────────────
PGSSLMODE=

# ─── Playwright / Chromium ─────────────────────────────────────────────────────
# Путь к Chromium для браузерной автоматизации Mango/Moizvonki
# Узнать путь: which chromium
MANGO_CHROMIUM_PATH=